@{
    ViewData["Title"] = "Home Page";
}

<div class="hero text-center">
    <div class="modern-card p-4 mx-auto" style="max-width:900px;">
        <h1>Welcome to the greatest film collection in history</h1>
        <p class="lead lead-accent">Brought to you by none other than Joel Hilton</p>
        <div class="mt-3 d-flex justify-content-center">
            <img src="~/img/JoelHiltonHeadshot.jpg" class="img-fluid img-rounded" style="max-height:480px;" alt="Joel Hilton" />
        </div>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="AddMovie" class="btn btn-accent">Add a Movie</a>
            <a asp-controller="Home" asp-action="GetToknowJoel" class="btn btn-outline-secondary ms-2">Learn about Joel</a>
        </div>
    </div>
</div>