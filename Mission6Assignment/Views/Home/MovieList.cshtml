@model IEnumerable<Mission6Assignment.Models.AddMovie>

@{
    ViewData["Title"] = "Movie List";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 modern-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="mb-0">Movie Collection</h1>
                <a asp-controller="Home" asp-action="AddMovie" class="btn btn-accent">Add Movie</a>
            </div>

            @if (!Model.Any())
            {
                <p>No movies currently in the collection.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Category</th>
                                <th>Title</th>
                                <th>Year</th>
                                <th>Director</th>
                                <th>Rating</th>
                                <th>Edited</th>
                                <th>Lent To</th>
                                <th>Copied to Plex</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var movie in Model.OrderBy(m => m.Title))
                            {
                                <tr>
                                    <td>@movie.Category?.CategoryName</td>
                                    <td>@movie.Title</td>
                                    <td>@movie.Year</td>
                                    <td>@movie.Director</td>
                                    <td>@movie.Rating</td>
                                    <td>@(movie.Edited ? "Yes" : "No")</td>
                                    <td>@movie.LentTo</td>
                                    <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                                    <td>@movie.Notes</td>
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-accent btn-fixed">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-sm btn-danger btn-fixed">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}